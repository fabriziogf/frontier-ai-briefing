# Copy to .env for local runs. In CI these are repository secrets.
ANTHROPIC_API_KEY=
TTS_API_KEY=
EMAIL_API_KEY=
FEEDBACK_HMAC_SECRET=
# 32-char random token for the private podcast feed path: python -c "import secrets; print(secrets.token_hex(16))"
PODCAST_PATH_TOKEN=

# Save to Spotify: locally the CLI keeps its own login (`save-to-spotify auth login`).
# For CI only, store these as repository secrets (base64 of the files in ~/.config/save-to-spotify/):
# STS_TOKEN_B64=
# STS_DPOP_KEY_B64=
